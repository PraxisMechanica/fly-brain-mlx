    "@eng-metrics/code-quality": "file:tools/code-quality/vendor/eng-metrics-code-quality-0.1.2.tgz"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@ast-grep/lang-go", "tree-sitter-c-sharp"]
  }
}
